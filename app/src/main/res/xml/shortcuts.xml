        android:enabled="true"
        android:icon="@drawable/ic_shortcut_incognito"
        android:shortcutShortLabel="@string/shortcut_incognito_short"
        android:shortcutLongLabel="@string/shortcut_incognito_long">
        <intent
            android:action="com.znarfm.siphon.action.SHORTCUT_INCOGNITO"
