<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="paste_and_sniff"
        android:enabled="true"
        android:icon="@android:drawable/stat_sys_download"
        android:shortcutShortLabel="@string/shortcut_paste_short"
        android:shortcutLongLabel="@string/shortcut_paste_long">
        <intent
            android:action="com.siphon.app.action.SHORTCUT_PASTE_SNIFF"
            android:targetPackage="com.siphon.app"
            android:targetClass="com.siphon.app.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_queue"
        android:enabled="true"
        android:icon="@android:drawable/stat_sys_download_done"
        android:shortcutShortLabel="@string/shortcut_queue_short"
        android:shortcutLongLabel="@string/shortcut_queue_long">
        <intent
            android:action="com.siphon.app.action.SHORTCUT_QUEUE"
            android:targetPackage="com.siphon.app"
            android:targetClass="com.siphon.app.ui.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_incognito_tab"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_view"
        android:shortcutShortLabel="@string/shortcut_incognito_short"
        android:shortcutLongLabel="@string/shortcut_incognito_long">
        <intent
            android:action="com.siphon.app.action.SHORTCUT_INCOGNITO"
            android:targetPackage="com.siphon.app"
            android:targetClass="com.siphon.app.ui.MainActivity" />
    </shortcut>
</shortcuts>
